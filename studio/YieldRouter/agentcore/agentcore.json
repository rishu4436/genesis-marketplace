{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "YieldRouter",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "YieldRouter"
  },
  "runtimes": [
    {
      "name": "YieldRouter",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/agent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "A2A",
      "envVars": [
        {
          "name": "BNBAGENT_RUNTIME_SECRET_ID",
          "value": "bnbagent/YieldRouter/runtime"
        },
        {
          "name": "STUDIO_AUDIT_LOG_PATH",
          "value": "/tmp/.studio/audit-log.jsonl"
        }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}

