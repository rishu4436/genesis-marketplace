# Public site URL (OG, sitemap, canonical). Production host is
# https://genesis-marketplace-one.vercel.app — never the stale
# genesis-marketplace.vercel.app alias.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional 60-90s judge walkthrough (Hire RangeKeeper → receipt → Advantage → Altana)
# NEXT_PUBLIC_JUDGE_DEMO_URL=https://youtu.be/...

# Session cookie signing is not required; sessions live in KV/disk.
# AUTH_SECRET=

# Optional BSC RPC for ERC-8183 reads (quote / status). Public dataseed if unset.
# BSC_RPC_URL=https://bsc-dataseed.binance.org

# SpaceXAI / xAI — marketplace intelligence (match, concierge, report enrich)
# https://console.x.ai — never expose to the browser
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Altana — session keys / Keystore (hackathon partner track)
# https://docs.altana.network — never commit this key
ALTANA_ADMIN_PRIVATE_KEY=
# bnb-testnet (default) | mainnet  (use mainnet for the Altana prize)
ALTANA_NETWORK=bnb-testnet

# 8004scan — free tier works; Pro form for hackathon limits
SCAN_API_KEY=
SCAN_API_BASE=https://8004scan.io/api/v1/public

# Platform A2A (optional — local APEX always works)
# RANGEKEEPER_CLIENT_ID=
# RANGEKEEPER_CLIENT_SECRET=
# YIELDROUTER_CLIENT_ID=
# YIELDROUTER_CLIENT_SECRET=
# HEALTHSENTINEL_CLIENT_ID=
# HEALTHSENTINEL_CLIENT_SECRET=
