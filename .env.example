SCAN_API_KEY=

# Override only if needed
# SCAN_API_BASE=https://8004scan.io/api/v1/public

# Public URL of this marketplace (used for local APEX serviceUrl resolution)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: pin Genesis agents after Agent Studio deploy
# Format: chainId:tokenId  e.g. 97:12345
# GENESIS_PIN_RANGE_KEEPER=
# GENESIS_PIN_GRIDWRIGHT=
# GENESIS_PIN_YIELD_ROUTER=
# GENESIS_PIN_HEALTH_SENTINEL=

# External Layer B base (…/apex) — overrides local /api/apex/:slug
# GENESIS_SERVICE_RANGE_KEEPER=https://YOUR_HOST:8003/apex
# GENESIS_SERVICE_GRIDWRIGHT=
# GENESIS_SERVICE_YIELD_ROUTER=
# GENESIS_SERVICE_HEALTH_SENTINEL=
