# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# durable job store (local / runtime)
/data/jobs/
/data/claims/
/data/altana-sessions/
/data/incidents/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent Studio workspaces (secrets in .studio/)
studio/**/.studio/
studio/**/.venv/
studio/**/app/agent/.venv/
studio/**/wheels/
studio/**/app/agent/wheels/

